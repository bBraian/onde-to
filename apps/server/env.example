# Variáveis do SERVIDOR (apps/server).
# O servidor NÃO lê arquivo de ambiente: passe na linha de comando, por exemplo
#   PORT=3001 CORS_ORIGIN=http://localhost:5180 pnpm --filter server dev
# No Render, cadastre no painel do serviço (Environment).
# Nenhuma destas é segredo.

# Porta HTTP/WebSocket. Local: 3001. No Render, a plataforma define sozinha.
PORT=3001

# Endereço EXATO do site (protocolo + host + porta), para o CORS.
# Local com o Vite na 5180: http://localhost:5180 · Publicado: o endereço da Vercel
CORS_ORIGIN=http://localhost:5180

# mapillary (padrão) ou google. Tem que ser igual ao VITE_STREET_PROVIDER do site.
STREET_PROVIDER=mapillary

# Só para testes automatizados: 1 libera o mapa "Teste" (lugares falsos). Deixe vazio no uso normal.
ENABLE_TEST_MAP=
