# Variáveis do SITE (apps/web).
# Copie este arquivo para apps/web/.env.local (que não vai para o git) e preencha o que está vazio.
# O Vite lê o .env.local sozinho ao rodar `pnpm exec vite`.

# ── Obrigatório no modo padrão (Mapillary) ─────────────────────────────────────────
# Client Token do Mapillary (começa com MLY|): mapillary.com/dashboard/developers
VITE_MAPILLARY_TOKEN=

# ── Servidor das salas ao vivo ─────────────────────────────────────────────────────
# Local: o servidor roda na 3001. Publicado: o endereço do Render (ex.: https://onde-to-server.onrender.com)
VITE_SERVER_URL=http://localhost:3001

# ── Provedor das fotos ─────────────────────────────────────────────────────────────
# mapillary (padrão, grátis) ou google. Tem que ser igual ao STREET_PROVIDER do servidor.
VITE_STREET_PROVIDER=mapillary

# Chave "do site" do Google (restrita por domínio + Maps JavaScript API). Só quando o provedor for google.
VITE_GOOGLE_MAPS_KEY=

# ── Só para testes automatizados (deixe vazio no uso normal) ─────────────────────────
# 1 = mostra um quadro falso no lugar da foto
VITE_FAKE_VIEWER=
# 1 = libera o mapa "Teste" (lugares falsos)
VITE_ENABLE_TEST_MAP=
