# Variáveis do SCRIPT DE MAPAS (scripts/build-maps). São segredos de uso: não commite valores.
# Passe na linha de comando, por exemplo
#   MAPILLARY_TOKEN='MLY|...' pnpm --filter build-maps build-maps
#   GOOGLE_MAPS_KEY='...'      pnpm --filter build-maps build-maps --provider google

# Client Token do Mapillary (o mesmo do site). Usado sem --provider ou com --provider mapillary.
MAPILLARY_TOKEN=

# Chave "do script" do Google: restrita SÓ à Street View Static API e sem restrição de site
# (o script roda no terminal). Usada com --provider google.
GOOGLE_MAPS_KEY=
